# Recordings are delivered separately; do not push large binary files.
*.mp4
*.webm
*.mov
*.mkv
*.zip
*.bundle

# Reproduction scratch outputs; final reports and control logs stay tracked.
reports/_reproduction/
reports/_tmp/
.pre-commit-cache/

